s = "A man, a plan, a canal: Panama"

def isPalindrome(self, s: str) -> bool:
    s1 = s.lower()

    i = 0
    j = len(s1) - 1

    while i < j:
        if s1[i].isalpha() and s1[j].isalpha():
            if s1[i] != s1[j]:
                return False

            i += 1
            j -= 1

        elif not s1[i].isalpha():
            i += 1

        elif not s1[j].isalpha():
            j -= 1

    return True
